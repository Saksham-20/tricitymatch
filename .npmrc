# Blanket peer-dependency suppression for the whole workspace.
#
# Needed because react-native / Expo SDK 52 declare peer ranges that conflict
# with each other and with the react@18.2.0 pin the root override enforces
# (mobile pins react 18.2.0, so the web side cannot move to 19 — see CLAUDE.md
# "Held dep migrations"). Without this, `npm install` fails outright.
#
# The cost is real and worth stating: npm will no longer refuse a genuinely
# incompatible transitive combination anywhere in the tree, in ANY workspace,
# not just the one that needs the exemption. backend/.npmrc carries its own
# narrower copy with its own reason (multer-storage-cloudinary vs cloudinary@2).
# Revisit when the react 19 / RN upgrade lands and this can be scoped down or
# dropped entirely.
legacy-peer-deps=true
