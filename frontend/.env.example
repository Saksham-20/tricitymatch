# =============================================================================
# TricityMatch Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# Vite only exposes variables prefixed with VITE_
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL (include /api prefix if needed)
VITE_API_URL=http://localhost:5000/api

# WebSocket URL (for real-time features)
VITE_WS_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# Get from https://dashboard.razorpay.com/app/keys
# Use test key for development, live key for production
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Cloudinary (Image Upload - if using direct upload)
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
VITE_CLOUDINARY_FOLDER=tricitymatch

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Enable analytics in production
VITE_ENABLE_ANALYTICS=false

# Error reporting endpoint
VITE_ERROR_REPORTING_URL=

# Google Analytics ID (if using)
VITE_GA_TRACKING_ID=

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable source maps in production (for debugging)
VITE_ENABLE_SOURCE_MAPS=false

# --- Support channels (Help Centre + footer) --------------------------------
# Unset means the channel is HIDDEN rather than shown with a placeholder.
# WhatsApp: digits only, with country code (wa.me format), e.g. 919812345678.
VITE_SUPPORT_EMAIL=support@tricitymatch.com
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_ADDRESS=

# --- Legal identity (Terms/Privacy pages) -----------------------------------
# Same doctrine: unset values are HIDDEN, never rendered as placeholders.
# Entity falls back to the brand name until incorporation.
VITE_LEGAL_ENTITY=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_GSTIN=
# Named natural person resident in India (IT Rules 2021 r.3(2)(a)).
VITE_GRIEVANCE_OFFICER=
VITE_GRIEVANCE_EMAIL=grievance@tricitymatch.com
